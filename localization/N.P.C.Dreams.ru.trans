          "Sahuagin2": 21,
          "Ogre": 22,
          "Gargoyle*2": 23,
          "Lamia": 24,
          "Vampire": 25,
          "Succubus": 26,
          "Demon": 27,
          "Demon Lord": 28,
          "Archdemon": 29,
          "Sahagin": 30,
          "Shrouded One": 31,
          "Mist": 32,
          "Shrouded Pair": 33,
