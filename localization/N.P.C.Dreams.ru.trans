        "data": [
          [
            "<マップ名Grand_Cathedral >\r\n<色調 30, -40, -60, 10>",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "EV003",
            ""
          ],
          [
            "Syvthiedy <SURLY>",
            ""
          ],
          [
            "It looks like she's devouring something...",
            "",
            "Похоже, она что-то пожирает..."
          ],
          [
            "Talk",
            "",
            "Говорить"
          ],
          [
            "\\c[2]Rape\r\n",
            "",
            "\\c[2]Изнасиловать"
          ],
          [
            "Leave",
            "",
            "Уйти",
            null,
            "Уйти"
          ],
          [
            "\"～～♪　～♪...　♪　～...♪　～～♪\n　　～～♪　～♪　...♪　～～...～♪　...～～♪\"",
            ""
          ],
          [
            "She's very small, seems to be singing...",
            "",
            "Она совсем маленькая, кажется, поёт..."
          ],
          [
            "She doesn't seem to be paying attention to me.",
            "",
            "Она словно не замечает меня."
          ],
          [
            "EV005",
            ""
          ],
          [
            "Kill Syvthiedy",
            "",
            "Убить Сивтиэди"
          ],
          [
            "EV006",
            ""
          ],
          [
            "Soul1",
            ""
          ],
          [
            "Soul2",
            ""
          ],
          [
            "EV008",
            ""
          ],
          [
            "EV009",
            ""
          ],
          [
            "Out of nowhere, I lost control of my body...!",
            "",
            "Внезапно я потерял власть над телом...!"
          ],
          [
            "\"...Ara?\"",
            "",
            "\"...Ара?\""
          ],
          [
            "\"...Fufu. I was starting to get really bored.\"",
            "",
            "\"...Фуфу. Я уже начинала по-настоящему скучать.\""
          ],
          [
            "\"I'm tired of playing with corpses,\nbut there's no scent of life around here anymore...\"",
            "",
            "\"Мне надоело играть с трупами,\nно вокруг больше нет ни запаха жизни...\""
          ],
          [
            "\"And then... I found you.\"",
            "",
            "\"И тогда... я нашла тебя.\""
          ],
          [
            "\"...Huh? You don't seem to be a living being, are you?\"",
            "",
            "\"...А? Ты ведь, похоже, не живое существо, верно?\""
          ],
          [
            "\"Does it really matter? It doesn't matter to me.\"",
            "",
            "\"Разве это важно? Мне — всё равно.\""
          ],
          [
            "\\c[18]\"If I tear your body apart!\nAll of you will be dyed the same color anyways!\"",
            "",
            "\\c[18]\"Если я разорву твоё тело на части!\nВсё, что есть в тебе, всё равно окрасится в один цвет!\""
          ]
        ],
