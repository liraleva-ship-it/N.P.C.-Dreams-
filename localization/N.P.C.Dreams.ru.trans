      "/data/CommonEvents::052.rvdata2": {
        "originalFormat": "RVDATA2 file",
        "basename": "CommonEvents::052.rvdata2",
        "filename": "CommonEvents::052.rvdata2",
        "path": "/data/CommonEvents::052.rvdata2",
        "relPath": "/data/CommonEvents::052.rvdata2",
        "data": [
          [
            "●YOU VANISHED",
            ""
          ],
          [
            "\n\\{\\{\\{\\c[22]　　　　　YOU VANISHED\\}\\}",
            "",
            "\n\\{\\{\\{\\c[22]　　　　　ТЫ ИСЧЕЗ\\}\\}",
            null,
            "\n\\{\\{\\{\\c[22]　　　　　ТЫ ИСЧЕЗ\\}\\}"
          ],
          [
            "\\c[8]\nUpon death, all souls you have within will be dropped.\nReturn to the place where you died, before the souls\nvanish from the world.",
            "",
            "\\c[8]\nПосле смерти все Души, что в тебе, выпадут наружу.\nВернись туда, где ты погиб, прежде чем Души\nисчезнут из мира.",
            null,
            "\\c[8]\nПосле смерти все Души, что в тебе, выпадут наружу.\nВернись туда, где ты погиб, прежде чем Души\nисчезнут из мира."
          ]
        ],
        "type": "",
        "context": [
          [
            "commonevents/52/name"
