        "relPath": "/data/Map032.rvdata2",
        "data": [
          [
            "<マップ名Blight_Grove >\r\n<色調 -30, 0, -30, 10>\r\n\r\n==マップフォグ疫雲[5,5,50,150,0]==",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "\"...I want those eyes...\"",
            "",
            "\"...Хочу эти глаза...\""
          ],
          [
            "EV002",
            ""
          ],
          [
            "EV003",
            ""
          ],
          [
            "EV004",
            ""
          ],
          [
            "EV005",
