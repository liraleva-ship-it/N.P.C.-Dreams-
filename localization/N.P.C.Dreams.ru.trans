          "Melf's Miniature Garden: The Depths of the Playground": 0,
          "<マップ名Melf's_Garden >\r\n<色調 50, 50, 40, 0>\r\n==マップフォグ日差し[0,0,100,200,1]==\r\n": 1,
          "EV001": 2,
          "The door won't open...": 3,
          "When I reach out, my arm slips through the door...\nShall I go through the door?": 4,
          "Go through": 5,
