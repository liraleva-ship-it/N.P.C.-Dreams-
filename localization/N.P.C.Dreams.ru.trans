        "data": [
          [
            "<マップ名Sea_of_Corpses >\r\n<色調 50, -15, -15, 0>\r\n<接触RC:11,217,$game_switches[274]>",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "Llawenydd ",
            "",
            "Ллавенюдд",
            null,
            "Ллавенидд"
          ],
          [
            "She's waiting for something...",
            "",
            "Она ждёт чего-то..."
          ],
          [
            "Talk",
            "",
            "Говорить"
          ],
          [
            "\\c[2]Rape",
            "",
            "\\c[2]Изнасиловать"
          ],
          [
            "Leave",
            "",
            "Уйти",
            null,
            "Уйти"
          ],
          [
            "There is no sign of any reaction...",
            "",
            "Нет никаких признаков реакции..."
          ],
          [
            "Llawenydd's Body",
            "",
            "Тело Ллавенюдд",
            null,
            "Тело Ллавенидд"
          ],
          [
            "EV012",
            ""
          ],
          [
            "EV013",
            ""
          ],
          [
            "Out of nowhere, I lost control of my body...!",
            "",
            "Внезапно я потерял власть над телом...!"
          ],
          [
            "\"……Ha ha ha. So this is how it is.\nI didn't expect the prey to come to me willingly.\"",
            "",
            "\"……Ха-ха-ха. Вот, значит, как.\nНе ждала, что добыча сама придёт ко мне.\""
          ],
          [
            "\"I was starving, thought I'd die of hunger...\nBut, well, it seems you'll be my last meal.\"",
            "",
            "\"Я умирала с голоду, думала, сгину от него...\nЧто ж, похоже, ты станешь моей последней трапезой.\""
          ],
          [
            "\"...Heh? You're offering your head?\nAnd here I was expecting a more exciting finale.\"",
            "",
            "\"...Хе? Сам подставляешь голову?\nА я-то ждала финала позанятнее.\""
          ],
          [
            "\\c[10]\"You're nothing but a pathetic failure.\nThe person who created you should have died.\"",
            "",
            "\\c[10]\"Ты всего лишь жалкая неудача.\nТому, кто тебя создал, лучше было бы умереть.\""
          ],
          [
            "\\c[18]\"─What?\"",
            "",
            "\\c[18]\"─Что?\""
          ],
          [
            "\"What...? Again? I'm going to lose?\nHa, ha, ha... pathetic creature...\"",
            "",
            "\"Что...? Снова? Я проиграю?\nХа, ха, ха... жалкое создание...\""
          ],
          [
            "\"Losing to you...?\nDamn it... I'm starving, and now this?\nYou... Little shit...\"",
            "",
            "\"Проиграть тебе...?\nПроклятье... Я с голоду подыхаю, и теперь ещё это?\nТы... Мелкий ублюдок...\""
          ],
          [
            "Soul1",
            ""
          ],
          [
            "Soul2",
            ""
          ],
          [
