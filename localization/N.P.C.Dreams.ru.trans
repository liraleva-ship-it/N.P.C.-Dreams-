        "indexIds": {
          "<マップ名Umbral_Basin >\r\n<色調 -55, -55, -55, 10>": 0,
          "EV001": 1,
          "EV002": 2,
          "EV003": 3,
          "Soul1": 4,
          "Soul2": 5,
          "EV007": 6,
          "I feel a maddening presence from behind...": 7,
          "I feel a maddening presence from here...": 8,
          "Dial": 9,
          "EV009": 10,
          "I... I can't move.": 11,
          "...I will never stop.": 12,
          "...I will never wither.": 13,
          "This Wrath will never perish...": 14,
          "...Still, you dare to challenge me?": 15,
          "...Your anger, your hatred.": 16,
          "I will devour it, make it my strength...": 17,
          "And then, everything...": 18,
          "Everything will be... within me...": 19,
          "My Wrath...": 20,
          "Will never perish...": 21,
          "...At last, it's time.": 22,
          "\n\\{\\{\\{\\c[18]　  \\} \\{YOU APPROACHED THE END \\}\\}": 23,
          "Fetus": 24,
          "NW名前指定 Fetus": 25,
          "\"...I won.\nWe won...\"": 26,
          "\"However even though we won...\nIt doesn't feel like this is the end...": 27,
          "Rifell <SURLY>": 28,
          "Protect her": 29,
          "Do nothing": 30,
          "Push her away": 31,
          "She's dead...": 32,
          "Hidden": 33,
          "Blood / Left": 34,
          "Blood / Right": 35,
          "EV015": 36,
          "EV016": 37,
          "\"...It's not over yet, is it?\"": 38,
          "\"No. \\n[1]-sama's face... even if you don't say it,\nI understand...\"": 39,
          "\"So you're heading forward, then.\"": 40,
          "\"Beyond the distortion...\nI cannot go there.\"": 41,
          "\"I'm sure the moment I step in there...\nI'll just end up dead.\"": 42,
          "\"But \\n[1]-sama,\nI don't think the same will happen to you.\"": 43,
          "\"...I will wait here for your return, \\n[1]-sama.\nPlease... come back safely.\"": 44,
          "\"\\n[1]-sama, you are so strong.\nI'm sure Arkos-sama was exactly like \\n[1]-sama...\"": 45,
          "The Distortion": 46,
          "Shall I move forward...?": 47,
          "Enter the distortion": 48,
          "Remain here": 49,
          "...Something is holding me back.": 50,
          "If I move forward, I'm sure I won't be able to turn back...": 51,
          "Move forward": 52,
          "Hesitate": 53,
          "EV018": 54,
          "\"I...\nWhen the being known as \\c[18]Dial\\c[0] was born,\nthe world was already...\"": 55,
          "\"... \\n[1].\nI... I think I want to go back to the orphanage.\"": 56,
          "\"...\"": 57,
          "\"I want to... talk with you, just the two of us.\"": 58,
          "EV019": 59,
          "\"Nee, \\n[1]...\nI wonder what's going on with my body...?\"": 60,
          "\"Like Risu said, did I really take her powers...?\n...If we really do defeat the Wrath,\neverything... will finally end.\"": 61,
          "\"I don't want you to worry about me.\nHow do I say this... I have no regrets.\n...I'm happy I got to travel with you one last time.\"": 62,
          "\"Well then, shall we go?\"": 63,
          "\"\\n[1]... Are you ready?\nI'll be right behind you.\"": 64,
          "\"We will definitely win this time.\"": 65,
          "EV020": 66
        },
        "indexIsBuilt": false,
        "progress": {
          "translated": 47,
          "length": 67,
          "percent": 70.1492537313433
        },
        "cellInfo": []
      },
