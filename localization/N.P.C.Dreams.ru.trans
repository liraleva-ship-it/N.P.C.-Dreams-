        "data": [
          [
            "Pale Village",
            "",
            "Бледная деревня"
          ],
          [
            "<マップ名Pale_Village >\r\n<色調 20, 20, 20, 30>\r\n==マップフォグ日差し[0,0,100,150,1]==",
            ""
          ],
          [
            "EV008",
            ""
          ],
          [
            "EV009",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "EV002",
            ""
          ],
          [
            "EV003",
