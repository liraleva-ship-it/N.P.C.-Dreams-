          "EV013": 16,
          "EV014": 17,
          "EV015": 18,
          "EV016": 19,
          "\\c[2]\nThere is no time left to waste.\nI've exhausted all of my options.": 20,
          "\\c[2]\nTo the messenger—\nI entrust everything I have to your arrival.": 21,
          "\\c[18]\nA black vortex rose onto the sky.": 22,
          "EV017": 23,
          "EV018": 24,
          "EV019": 25,
          "EV020": 26,
          "<SURLY>": 27,
