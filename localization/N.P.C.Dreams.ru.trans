        "indexIds": {
          "Obetion's Scar": 0,
          "EV001": 1,
          "ここから上は歩けるよ！": 2,
          "EV002": 3,
          "\\c[18]...My anger will never end.": 4,
          "\\c[18]...I will never forget my humiliation.": 5,
          "\\c[18]I will consume everything within me....": 6,
          "\\c[18]Yet, it continues to resist...": 7,
          "\\c[18]Surrender yourselves, welcome destruction.": 8,
          "\\c[18]Know that from the start, it is a futile struggle.": 9,
          "\n\\{\\{\\{\\c[30]　 　　YOU REACHED THE END\\}\\}": 10,
          "\"Ah...\"": 11,
          "\"We...\"": 12,
          "\"...! It was... No, no!\nWhat have we done...\"": 13,
          "\\c[18]Ah, it does not fade... It refuses to scatter...!!": 14,
          "\\c[18]Messenger...!!": 15,
          "\\c[18]You... have awakened the power of unending demise...!!": 16,
          "\\c[18]Feel the torrent of my wrath upon your flesh...!!": 17,
          "...It is not over yet.": 18,
          "\\c[18]...My very being.": 19,
          "\\c[18]Everything comes from within me...": 20,
          "\\c[18]You too, remain unchanged...": 21,
          "\\c[18]Messenger...": 22,
          "\\c[18]Even you, are no different...": 23,
          "\n\\{\\{\\{\\c[18]　 　　YOU REACHED THE END\\}\\}": 24,
          "\\c[18]...Soon, we shall disappear.": 25,
          "\\c[18]You and I both...": 26,
          "\\c[18]Everything...": 27,
          "Dial": 28,
          "EV004": 29,
          "Vortex": 30,
          "EV006": 31,
          "EV007": 32,
          "\n\\{\\{\\{\\c[30] \\}       \\{THE DREAM IS OVER \\}\\}": 33,
          "EV008": 34,
          "\n\\{\\{\\{\\c[1] \\}       \\{THE DREAM IS OVER \\}\\}": 35
        },
