      "/data/Map115.rvdata2": {
        "originalFormat": "RVDATA2 file",
        "basename": "Map115.rvdata2",
        "filename": "Map115.rvdata2",
        "path": "/data/Map115.rvdata2",
        "relPath": "/data/Map115.rvdata2",
        "data": [
          [
            "<マップ名Abyssal_Sanctum >\r\n<色調 -10, -30, -10, 0>\r\n==マップフォグ霧[5,5,50,30,0]==",
            ""
          ],
          [
            "EV001<SURLY>",
            ""
          ],
          [
            "It's locked...",
            "",
            "Заперто..."
          ],
          [
            "Use the Dream Key",
            "",
            "Использовать Ключ Снов"
          ],
          [
            "Leave",
            "",
            "Уйти",
            null,
            "Уйти"
          ],
          [
            "When I reach out, my arm slips through the door...\nShall I go through the door?",
            "",
            "Стоит протянуть руку — она проходит сквозь дверь...\nПройти сквозь дверь?"
          ],
          [
            "Go through",
            "",
            "Пройти"
          ],
          [
            "Remain here",
            "",
            "Остаться"
          ],
          [
            "EV002",
            ""
          ],
          [
            "EV003",
            ""
          ],
          [
            "EV004",
            ""
          ],
          [
            "EV005",
            ""
          ],
          [
            "EV006",
            ""
          ],
          [
            "EV007",
            ""
          ],
          [
            "EV008",
            ""
          ],
          [
            "EV009",
