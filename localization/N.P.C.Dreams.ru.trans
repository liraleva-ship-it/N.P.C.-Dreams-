          ],
          [
            "EV002",
            ""
          ],
          [
            "Get \\c[23]Whispering Call\\c[0]",
            "",
            "Получить \\c[23]Шепчущий Зов\\c[0]"
          ],
          [
            "Get \\c[24]Shrill Cry\\c[0]",
            "",
            "Получить \\c[24]Пронзительный Крик\\c[0]"
          ],
          [
            "Convert \\c[23]Whispering Call\\c[0] to \\c[23]Call\\c[0]",
            "",
            "Обменять \\c[23]Шепчущий Зов\\c[0] на \\c[23]Зов\\c[0]"
          ],
          [
            "Convert \\c[24]Shrill Cry\\c[0] to \\c[24]Cry\\c[0]",
            "",
            "Обменять \\c[24]Пронзительный Крик\\c[0] на \\c[24]Крик\\c[0]"
          ],
          [
            "\\c[23]Call\\c[0]: Restores 50% HP.\n　　　　　　　↓\n\\c[23]Whispering Call\\c[0]: Restores 50% HP.\\c[10] (No turn cost)",
            "",
            "\\c[23]Зов\\c[0]: восстанавливает 50% HP.\n　　　　　　　↓\n\\c[23]Шепчущий Зов\\c[0]: восстанавливает 50% HP.\\c[10] (не тратит ход)"
          ],
          [
            "『Trade『\\c[2]3 \\c[0]\\c[23]Call\\c[0]』 to get 『\\c[2]1 \\c[0]\\c[23]Whispering Call\\c[0]』.\n\n\\c[2]※ You cannot trade unless you have obtained at least 3 Calls.",
            "",
            "『Обменять『\\c[2]3 \\c[0]\\c[23]Зова\\c[0]』 на 『\\c[2]1 \\c[0]\\c[23]Шепчущий Зов\\c[0]』.\n\n\\c[2]※ Обмен возможен, только если есть хотя бы 3 Зова."
          ],
          [
            "『Trade \\c[2]3 \\c[0]\\c[23]Call\\c[0]』 to get 『\\c[2]1 \\c[0]\\c[23]Whispering Call\\c[0]』.\nEnter the number of Whispering Calls to obtain.\n\\c[8]Call owned: \\v[21]　　\\c[2]Tradeable Whispering Call: \\v[1]\n\\c[7]※ If you enter more than you have, all of it will be converted.",
            "",
            "『Обменять \\c[2]3 \\c[0]\\c[23]Зова\\c[0]』 на 『\\c[2]1 \\c[0]\\c[23]Шепчущий Зов\\c[0]』.\nВведи число Шепчущих Зовов для получения.\n\\c[8]Зовов: \\v[21]　　\\c[2]Доступно Шепчущих Зовов: \\v[1]\n\\c[7]※ Введёшь больше, чем есть — обменяется всё."
          ],
          [
            "\\c[24]Cry\\c[0]: Restores 50% MP.\n　　　　　　　↓\n\\c[24]Shrill Cry\\c[0]: Restores 50% MP.\\c[10] (No turn cost)",
            "",
            "\\c[24]Крик\\c[0]: восстанавливает 50% MP.\n　　　　　　　↓\n\\c[24]Пронзительный Крик\\c[0]: восстанавливает 50% MP.\\c[10] (не тратит ход)"
          ],
          [
            "『Trade \\c[2]3 \\c[0]\\c[24]Cries\\c[0]』 to get 『\\c[2]1 \\c[0]\\c[24]Shrill Cry\\c[0]』.\n\n\\c[2]※ You cannot trade unless you have obtained at least 3 Cries.",
            "",
            "『Обменять \\c[2]3 \\c[0]\\c[24]Крика\\c[0]』 на 『\\c[2]1 \\c[0]\\c[24]Пронзительный Крик\\c[0]』.\n\n\\c[2]※ Обмен возможен, только если есть хотя бы 3 Крика."
          ],
          [
