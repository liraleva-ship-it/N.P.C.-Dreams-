      "/data/Map227.rvdata2": {
        "originalFormat": "RVDATA2 file",
        "basename": "Map227.rvdata2",
        "filename": "Map227.rvdata2",
        "path": "/data/Map227.rvdata2",
        "relPath": "/data/Map227.rvdata2",
        "data": [
          [
            "<色調 20, 20, 20, 30>\r\n==マップフォグ日差し[0,0,100,200,1]==\r\n<マップ名Crossroads >",
            ""
          ],
          [
            "EV024",
            ""
          ],
          [
            "EV026",
            ""
          ],
          [
            "EV015",
            ""
          ],
          [
            "EV016",
            ""
          ],
          [
            "EV017",
            ""
          ],
          [
            "EV018",
            ""
          ],
          [
            "EV019",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "EV002",
