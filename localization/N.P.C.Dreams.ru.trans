        "data": [
          [
            "Obetion's Scar",
            "",
            "Шрам Обетиона"
          ],
          [
            "EV001",
            ""
          ],
          [
            "ここから上は歩けるよ！",
            ""
          ],
          [
            "EV002",
            ""
          ],
          [
            "\\c[18]...My anger will never end.",
            "",
            "\\c[18]...Моему гневу не будет конца."
          ],
          [
            "\\c[18]...I will never forget my humiliation.",
            "",
            "\\c[18]...Я не забуду своего унижения."
          ],
          [
            "\\c[18]I will consume everything within me....",
            "",
            "\\c[18]Я поглощу в себе всё...."
          ],
          [
            "\\c[18]Yet, it continues to resist...",
            "",
            "\\c[18]И всё же оно продолжает сопротивляться..."
          ],
          [
            "\\c[18]Surrender yourselves, welcome destruction.",
            "",
            "\\c[18]Покоритесь, примите разрушение."
          ],
          [
            "\\c[18]Know that from the start, it is a futile struggle.",
            "",
            "\\c[18]Знайте: с самого начала эта борьба тщетна."
          ],
          [
            "\n\\{\\{\\{\\c[30]　 　　YOU REACHED THE END\\}\\}",
            "",
            "\n\\{\\{\\{\\c[30]　 　　ТЫ ДОСТИГ КОНЦА\\}\\}"
          ],
          [
            "\"Ah...\"",
            "",
            "\"Ах...\"",
            null,
            "\"Ах...\""
          ],
          [
            "\"We...\"",
            "",
            "\"Мы...\""
          ],
          [
            "\"...! It was... No, no!\nWhat have we done...\"",
            "",
            "\"...! Это было... Нет, нет!\nЧто же мы натворили...\""
          ],
          [
            "\\c[18]Ah, it does not fade... It refuses to scatter...!!",
            "",
            "\\c[18]Ах, оно не угасает... Не желает рассеиваться...!!"
          ],
          [
            "\\c[18]Messenger...!!",
            "",
            "\\c[18]Вестник...!!"
          ],
          [
            "\\c[18]You... have awakened the power of unending demise...!!",
            "",
            "\\c[18]Ты... пробудил силу нескончаемой гибели...!!"
          ],
          [
            "\\c[18]Feel the torrent of my wrath upon your flesh...!!",
            "",
            "\\c[18]Ощути поток моего гнева на своей плоти...!!"
          ],
          [
            "...It is not over yet.",
            "",
            "...Это ещё не конец."
          ],
          [
            "\\c[18]...My very being.",
            "",
            "\\c[18]...Само моё естество."
          ],
          [
            "\\c[18]Everything comes from within me...",
            "",
            "\\c[18]Всё исходит из меня самого..."
          ],
          [
            "\\c[18]You too, remain unchanged...",
            "",
            "\\c[18]И ты тоже не изменишься..."
          ],
          [
            "\\c[18]Messenger...",
            "",
            "\\c[18]Вестник..."
          ],
          [
            "\\c[18]Even you, are no different...",
            "",
            "\\c[18]Даже ты ничем не отличаешься..."
          ],
          [
            "\n\\{\\{\\{\\c[18]　 　　YOU REACHED THE END\\}\\}",
            "",
            "\n\\{\\{\\{\\c[18]　 　　ТЫ ДОСТИГ КОНЦА\\}\\}"
          ],
          [
            "\\c[18]...Soon, we shall disappear.",
            "",
            "\\c[18]...Скоро мы исчезнем."
          ],
          [
            "\\c[18]You and I both...",
            "",
            "\\c[18]И ты, и я..."
          ],
          [
            "\\c[18]Everything...",
            "",
            "\\c[18]Всё..."
          ],
