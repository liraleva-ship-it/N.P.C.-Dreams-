      "/data/Map103.rvdata2": {
        "originalFormat": "RVDATA2 file",
        "basename": "Map103.rvdata2",
        "filename": "Map103.rvdata2",
        "path": "/data/Map103.rvdata2",
        "relPath": "/data/Map103.rvdata2",
        "data": [
          [
            "<マップ名Hal_Riad>\r\n<色調 -61, -102, -1, 10>",
            ""
          ],
          [
            "EV001",
            ""
          ],
          [
            "EV002",
