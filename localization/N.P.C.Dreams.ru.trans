          [
            "EV006",
            ""
          ],
          [
            "Out of nowhere, I lost control of my body...!",
            "",
            "Внезапно я потерял власть над телом...!"
          ],
          [
            "\"Ara, has another one of our friends arrived?\"",
            "",
            "\"Ара, неужто прибыл ещё один наш друг?\""
          ],
          [
            "\"Looks like it... then, we'd better greet them first.\"",
            "",
            "\"Похоже на то... тогда нам стоит первыми его поприветствовать.\""
          ],
          [
            "\"Kill...\"",
            "",
            "\"Убить...\""
          ],
          [
            "\"Maaaaa, oooogyaaaaaa? Aaaare you still alive?\"\\^",
            "",
            "\"Мааааа, ооогяааааа? Тыыы ещё жив?\"\\^"
          ],
          [
            "\"Pii-hyororororororo!\"\\^",
            "",
            "\"Пии-хьороророророро!\"\\^"
          ],
          [
            "\"The audience! The audience! Hey, they're watching!\\^\nWhat are they looking at?\"\\^",
            "",
            "\"Зрители! Зрители! Эй, они смотрят!\\^\nНа что это они уставились?\"\\^"
          ],
          [
            "\"Slurp, slurp, slurp...\"\\^",
            "",
            "\"Хлюп, хлюп, хлюп...\"\\^"
          ],
          [
            "\"Shut up, be quiet.\"\\^",
            "",
            "\"Молчи, тихо.\"\\^"
          ],
          [
            "\"AHAHAHAHAHAHAHAHAHAHAHAHAHA...!!!!!!\"",
            "",
            "\"АХАХАХАХАХАХАХАХАХАХАХАХАХА...!!!!!!\""
          ],
          [
            "Soul1",
