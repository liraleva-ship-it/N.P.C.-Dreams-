        "indexIds": {
          "Church of the Sword": 0,
          "<マップ名The_Church >\r\n<色調 70, 60, 30, 10>\r\n==マップフォグ日差し[0,0,50,200,1]==": 1,
          "EV001": 2,
          "EV002": 3,
          "EV003": 4,
          "EV005": 5,
          "EV007": 6,
          "EV008": 7,
          "EV009": 8,
          "EV010": 9,
          "EV011": 10,
          "ネームウィンドウ on": 11,
          "\"...Hello.\nAre you a pilgrim?\"": 12,
          "Talk": 13,
          "\\c[2]Rape": 14,
          "Leave": 15,
          "\"The followers still wander the church.\nIf you wish to offer prayers to the Sword of Loyalty,\nplease do so here.\"": 16,
          "\"I see... so Lord Tarian...\"": 17,
          "\"In that case...\nThat's probably what Lord Tarian wanted.\"": 18,
          "\"I see... I must prepare myself, then.\"": 19,
          "The conversation doesn't match...": 20,
          "\"I believe it's time to leave this place.\nI'm sure that's what Lord Tarian desired.\"": 21,
          "\"To destroy The Crimson Wrath. Our master's goal...\nand Lord Tarian's long-cherished wish.\"": 22,
          "\"...Loyalty is within the truth.\nWe must become the last swords...\nand sever the never-ending Crimson Wrath.\"": 23,
          "\"Destroying the Crimson Wrath. Was our master's wish...\nWill it be left unfulfilled? As the world ends...?\"": 24,
          "\"...Loyalty is within truth.\nI will be the last sword... and definitely...\"": 25,
          "EV013": 26,
          "EV014": 27,
          "EV015": 28,
          "EV016": 29,
          "EV017": 30,
          "EV018": 31,
          "EV019": 32,
          "EV020": 33,
          "EV021": 34,
          "EV012": 35,
          "It's locked...": 36,
          "Use the Dream Key": 37,
          "When I reach out, my arm slips through the door...\nShall I go through the door?": 38,
          "Go through": 39,
          "Remain here": 40,
          "EV006": 41,
          "The crystal shows no reaction...": 42,
          "EV023": 43,
          "EV022": 44,
          "EV024": 45,
          "EV025": 46,
          "EV026": 47,
          "EV029": 48,
          "EV030": 49,
          "EV031": 50,
          "EV034": 51,
          "EV032": 52,
          "EV033": 53,
          "EV027": 54,
          "EV028": 55,
          "EV004": 56,
          "\"...I've been here a few times before.\"": 57,
          "\"There were many people here then...\nIt was a very warm place.\"": 58,
          "\"...\"": 59,
          "\"─Ah, sorry.\nIt just feels so nostalgic...\"": 60,
          "EV035": 61
        },
