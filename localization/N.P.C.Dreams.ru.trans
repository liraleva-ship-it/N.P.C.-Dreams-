        "indexIds": {
          "<マップ名Sea_of_Corpses >\r\n<色調 50, -15, -15, 0>": 0,
          "EV001": 1,
          "EV002": 2,
          "EV003": 3,
          "EV004": 4,
          "EV005": 5,
          "EV006": 6,
          "EV007": 7,
          "EV008": 8,
          "EV009": 9,
          "EV027": 10,
