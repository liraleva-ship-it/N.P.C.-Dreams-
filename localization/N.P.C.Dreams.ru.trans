      "/data/Map225.rvdata2": {
        "originalFormat": "RVDATA2 file",
        "basename": "Map225.rvdata2",
        "filename": "Map225.rvdata2",
        "path": "/data/Map225.rvdata2",
        "relPath": "/data/Map225.rvdata2",
        "data": [
          [
            "EV001",
            ""
          ],
          [
            "　　　　　　　　　　　　　 　　Dream.\\!\n　　　　　　　　　　　　It is a graveyard. \\!\n　　　　　　　　   It is the remains of thoughts. \\!\n　　　　　　It is the sea of stardust where the corpses gather.",
            "",
            "　　　　　　　　　　　　　 　　Сон.\\!\n　　　　　　　　　　　　Это кладбище. \\!\n　　　　　　　　   Это останки мыслей. \\!\n　　　　　　Это море звёздной пыли, где сходятся трупы."
          ],
          [
            "　　　　　　 　　　　　　 The dream spans all,\\!\n　　　　　　 　　　　　　The dream remembers all,\\!\n　　　　　　 　　　　    The dream leaves all behind,\\!\n　　　　　　 　　 　  And the dream has closed everything.",
            "",
            "　　　　　　 　　　　　　 Сон объемлет всё,\\!\n　　　　　　 　　　　　　Сон помнит всё,\\!\n　　　　　　 　　　　    Сон оставляет всё позади,\\!\n　　　　　　 　　 　  И сон затворил всё."
          ],
          [
            "\n　　　　　　　　　　　　　　 Messenger.\n\\>　　　　　　　　　　 \\<　Come forth, to the truth.",
            "",
            "\n　　　　　　　　　　　　　　 Вестник.\n\\>　　　　　　　　　　 \\<　Иди же, к истине."
          ],
          [
            "\n　　　　　　　　　　　　　　 Know all,\n\\>　　　　　　　　　　　　　\\< and awaken it.",
            "",
            "\n　　　　　　　　　　　　　　 Познай всё,\n\\>　　　　　　　　　　　　　\\< и пробуди её."
          ],
          [
            "\n　　　　　　　　　At the bottom of the distant dream,\n\\>　　　　　　　　\\< sleeping in the world, lies the true truth.",
            "",
            "\n　　　　　　　　　На дне далёкого сна,\n\\>　　　　　　　　\\< спящая в мире, лежит истинная истина."
          ],
          [
            "\\{\\{             N.P.C.Dreams\\c[22]\n   \\}\\}  \\{\\{        TO GWIRIONEDD",
            "",
            "\\{\\{             N.P.C.Dreams\\c[22]\n   \\}\\}  \\{\\{        К ГВИРИОНЕДД",
            null,
            "\\{\\{             N.P.C.Dreams\\c[22]\n   \\}\\}  \\{\\{        К ГВИРИОННЕДД"
          ]
        ],
