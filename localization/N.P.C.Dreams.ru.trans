        "indexIds": {
          "Umbral Basin": 0,
          "<マップ名Umbral_Basin >\r\n<色調 -55, -55, -55, 10>": 1,
          "EV001": 2,
          "\n\\{\\{\\{\\c[18]　　　 \\}\\}  \\{\\{BOUNDARY LINKED\\}\\}": 3,
          "The crystal shows no reaction...": 4,
          "EV002": 5,
          "EV003": 6,
          "EV004": 7,
          "EV005": 8,
          "EV006": 9,
          "EV007": 10,
          "NW名前指定 Fetus": 11,
          "\"...It's strong, I can feel his power.\"": 12,
          "\"...The world became like this because of him.\n\\c[8]Ethereal of Eternity\\c[0], \\c[29]Ethereal of Plague\\c[0], \\c[27]Ethereal of Dreams\\c[0]...\nThey all worked together to bring ruin.\"": 13,
          "\"...It all began with him.\nHe corrupted everything, destroyed everything,\nand now he's trying to end everything...\"": 14,
          "\"...\\n[1]. Let's fight together...\nThen, we will end all of this... Together...\"": 15,
          "Yes": 16,
          "No": 17,
          "\"...Thank you, \\n[1].\"": 18,
          "\"...I'm really glad I met you.\"": 19,
          "\"...\\n[1].\nAre you stupid enough to try to fight him alone?\nI know you had a few screws loose in your head but seriously!?\"": 20,
          "\"What are you trying to tell me after coming all the way here!\"": 21,
          "\"It will be nearly impossible to win even if we are together!\"": 22,
          "\"─...!!\"": 23,
          "\"I'm sorry...\nIf you really think it's better for you to be alone I suppose,\nI won't stop you...\"": 24,
          "\"But please change your mind, at least let's fight together...?\"": 25,
          "\"I'm not ready for this, but we have no choice...\"": 26,
          "\"...\"": 27,
          "Talk": 28,
          "\\c[2]Rape": 29,
          "Fight together if(s[249])": 30,
          "Leave": 31,
          "\"...\\n[1].\nWhy... why are you always with me?\"": 32,
          "\"...Fufu. It's okay.\nEven if you don't understand, even if you don't remember.\"": 33,
          "\"...I'll always remember.\"": 34,
          "\"Nee, \\n[1]. I can fight, you know?\nOr maybe my power isn't enough for your eyes?\"": 35,
          "\"...Actually, to be honest, if you really abandoned me,\nI was going to fight on my own, whether you came or not.\"": 36,
          "\"We don't have any time left anymore...\nLet's make sure we at least have something to save.\"": 37,
          "\"...Thank you. For letting me fight with you.\"": 38,
          "\"We will definitely defeat Dial...\"": 39,
          "Riferu": 40,
          "\"I have lived for this very moment.\"": 41,
          "\"To honor Lord Tarian... and for the world.\nAs well as for our swordmasters.\"": 42,
          "\"...Shall we go together? To put an end to the\nCrimson Wrath and bring light back to the world!\"": 43,
          "\"...Thank you,\nIn this world, it seems that...\nwe are the only ones who can fight against it.\"": 44,
          "\"Together... let us save the world.\"": 45,
          "\"...Ah, there is one important thing I forgot to ask.\nWhat is your name?\"": 46,
          "\"...\\n[1]-sama.\"": 47,
          "\"I will not forget this name until death.\"": 48,
          "\"Is that so... No-\nI won't force you to fight.\nI will defeat the Crimson Wrath alone if I must.\"": 49,
          "\"I have been protected by the sword,\nand I have lived for the sword.\nTo protect everyone, to save everyone, this is my duty\nas one who follows the sword of loyalty.\"": 50,
          "\"By slaying the Crimson Wrath,\nI hope to save the future of the world...\"": 51,
          "Fight together if(s[250])": 52,
          "\"...If we were to destroy the Crimson Wrath...\nBut if there are no people to repopulate the world,\nthen the world would be as good as destroyed.\"": 53,
          "\"...When the time comes... umm-\nWould you be willing to 'unite' with me?\"": 54,
          "\"…Ah, of course. \\n[1]-sama...\nIf there is someone who you already love,\nand that person is still alive,\nthen that's a different story...\"": 55,
          "\"I see. If...\nThe time comes for me to take a partner...\nI will rely on \\n[1]-sama.\"": 56,
          "\"When the battle begins, this place will be dangerous.\nPlease try to escape to somewhere far from here.\"": 57,
          "\"...Sky of Pale Eternity should be relatively safe.\"": 58,
          "\"...You've made up your mind, haven't you?\"": 59,
          "\"Then let us fight together...!\nFinish the battle against the Crimson Wrath...\nAlive... Together...\"": 60
        },
        "indexIsBuilt": false,
