        "indexIds": {
          "<マップ名Abyssal_Sanctum >\r\n<色調 -10, -30, -10, 0>\r\n==マップフォグ霧[5,5,50,30,0]==": 0,
          "EV001<SURLY>": 1,
          "It's locked...": 2,
          "Use the Dream Key": 3,
          "Leave": 4,
          "When I reach out, my arm slips through the door...\nShall I go through the door?": 5,
          "Go through": 6,
          "Remain here": 7,
          "EV002": 8,
          "EV003": 9,
          "EV004": 10,
          "EV005": 11,
          "EV006": 12,
          "EV007": 13,
          "EV008": 14,
          "EV009": 15,
          "EV010": 16,
          "EV011": 17,
          "EV012": 18,
          "EV013": 19,
          "EV014": 20,
          "EV015": 21,
          "EV016": 22,
          "EV017": 23,
          "EV018": 24,
          "EV019": 25,
          "Fetus": 26,
          "NW名前指定 Fetus": 27,
          "\"...\\n[1]. I'm going to say something really pathetic now..\"": 28,
          "\"I can't stop shaking ever since I got here... It's so cold...\nMaybe I've been affected by Maruoris' magic.\nJust trying to hold back the fear...\nI'm barely managing to do it, I want to run away...\"": 29,
          "Did you come from the mansion?": 30,
          "Be silent": 31,
          "\"...Huh? No I didn't.\nI came straight from the village to defeat \\c[30]Maruoris\\c[0].\"": 32,
          "\"...I know it's not a good idea to ask for this but,\nif you're going to fight \\c[30]Maruoris\\c[0], Can I come with you?\nI'll do my best... I want to be useful to you.\"": 33,
          "\"...Will you take me with you?\"": 34,
          "Yes": 35,
          "No": 36,
          "\"...Thank you.\"": 37,
          "\"...We'll definitely get through this together.\"": 38,
          "\"...Yeah, you're right.\nI don't have to do everything. You are powerful too.\"": 39,
          "\"I... I'll move once this shaking stops.\nIf you defeat \\c[30]Maruoris\\c[0] maybe my shaking will settle down...\"": 40,
          "\"...Please, don't die.\"": 41,
          "\"\\n[1]... The origin of \\c[30]Abyssal Dream\\c[0] lies in putting people\ninto a \\c[30]Deep Slumber\\c[0].\n...Be careful not to fall asleep.\"": 42,
          "\"...Thinking that you'll take me with you has eased some of my fear.\nBut please, don't overdo it just because you're worried about me.\"": 43,
          "Talk": 44,
          "\\c[2]Rape": 45,
          "Fight together if(s[210])": 46,
          "\"...Will you stay by my side?\nHonestly, this was a really big deal for me.\nI'm very happy, but...\"\n": 47,
          "\"For the sake of the world... Please,\n\\n[1]... Please, as soon as possible...\"": 48,
          "\"If there's chance we might get cornered, I want you to rely on me.\nI'll figure something out, I promise.\"": 49,
          "\"...Fufu.\nI might not look like it, but I am quite strong you know?\"": 50,
          "\"...Eh? Is it really okay to come with you?\"": 51,
          "\"...I'll do my best so that you won't regret it.\"": 52,
          "<SURLY>": 53,
          "Soul1": 54,
          "Soul2": 55,
          "EV035": 56,
          "EV036": 57
        },
