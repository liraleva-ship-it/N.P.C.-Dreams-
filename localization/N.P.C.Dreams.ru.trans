        "indexIds": {
          "<マップ名Rotting_Valley >\r\n<色調 -61, -72, -1, 10>": 0,
          "EV001": 1,
          "EV004": 2,
          "EV002": 3,
          "\"A...ah...\"": 4,
          "Talk": 5,
          "\\c[2]Rape": 6,
          "Leave": 7,
          "It seems my voice isn't reaching you...": 8,
          "EV003": 9,
          "EV005": 10,
          "Soul1": 11,
          "Soul2": 12,
          "EV010": 13,
          "\"Ah. Ah!\nIs anyone there...?\"": 14,
          "Answer": 15,
          "Be silent": 16,
          "\"...It feels so good, doesn't it?!\\!\nI thought it would be very scary but this is amazing!!!\\!\nWe are all seeing this, the shine of the stars...!!\nWe are seeing the very truth of the world...!\"": 17,
          "\"Ahahahaha...!! Maruoris-sama is amazing...!!!\\!\nDoes this mean I won't have to die now...?\nI wonder if I can go to a new era with Maruoris-sama!\"": 18,
          "\"Hey, you... What about you!?\nAre you also, like this?\nTrying to welcome the new age with Maruoris-sama...!?\"": 19,
          "That's right": 20,
          "This world will end": 21,
          "\"Oh, brother...!! Thank you!\nI'd love to see your face, but as you can see...\\!\nNevermind- At least I am relieved now. I'm quite sleepy,\nWhen we start going to a new era, please wake me up...\"": 22,
          "\"...But, hey, there is some hope right?!\nWe have to believe that Maruoris-sama will somehow save\nthe world, shouldn't we...?\"": 23,
          "\"Come on, whisper it! With me! Maestor Maruoris...\nMaestor Maruoris...!!!\nMaruoris-sama will save us all!!\nAhahahaha...!!\"": 24,
          "\"I'm sure you're not too late either...\nYou should be able to become a resident of the new era.\nSo... so, there's no need to be... so afraid, right?\"": 25,
          "\"Ah, I'm starting to feel sleepy...\nI'll sleep a little, alongside these stars...!\\!\nYou hang in there too...\"": 26,
          "\"...\"": 27,
          "He stopped breathing": 28,
          "EV011": 29
        },
        "indexIsBuilt": false,
        "progress": {
          "translated": 20,
          "length": 30,
          "percent": 66.66666666666666
        },
        "cellInfo": []
      },
